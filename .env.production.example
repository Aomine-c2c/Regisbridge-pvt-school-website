# ==============================================================================
# Regisbridge School Management System — Production Environment Configuration
# Copy this file to .env.production on the server and update secrets accordingly.
# Auto-generated secrets can also be created via `deploy/setup_server.sh`.
# ==============================================================================

# --- Host Integration ---
# Path on host filesystem where the Unix domain socket is shared
SOCKET_DIR=/run/regisbridge

# Server Domain or IP
SERVER_DOMAIN=regisbridge.page

# --- Database Credentials (Internal PostgreSQL Container) ---
POSTGRES_USER=regisbridge_admin
POSTGRES_PASSWORD=replace_with_a_secure_random_db_password_here

# --- Authentication & Session Secrets (Generate via: openssl rand -base64 64) ---
JWT_SECRET=replace_with_64_char_secret_for_jwt_auth_tokens_1234567890abcdef
JWT_REFRESH_SECRET=replace_with_64_char_secret_for_jwt_refresh_tokens_1234567890abcdef
NEXTAUTH_SECRET=replace_with_64_char_secret_for_nextauth_sessions_1234567890abcdef

# --- Application URLs ---
NEXTAUTH_URL=https://regisbridge.page
NEXT_PUBLIC_APP_URL=https://regisbridge.page

# --- Django Backend Configuration ---
DJANGO_SECRET_KEY=replace_with_random_django_secret_key_1234567890abcdefghijklmnopqrstuv
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=regisbridge.page,www.regisbridge.page,school.regisbridge.page,192.168.1.68,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://regisbridge.page,https://www.regisbridge.page,http://192.168.1.68:8080,http://localhost

# Initial Superuser credentials for Django /django-admin/
DJANGO_SUPERUSER_EMAIL=admin@regisbridge.edu
DJANGO_SUPERUSER_PASSWORD=ChangeMeInProduction123!

# --- Email Notifications (Optional SendGrid) ---
SENDGRID_API_KEY=
FROM_EMAIL=noreply@regisbridge.edu

# --- Runtime Tuning ---
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
